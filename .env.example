# Copy to .env for local development, and set the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# --- Sending emails (Gmail) -------------------------------------------------
# Use a Google App Password, NOT the account password. Requires 2-step
# verification on the account: https://myaccount.google.com/apppasswords
SMTP_USER=signatureacte@gmail.com
SMTP_PASS=

# Optional: to move off Gmail later, point these at another provider.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Who gets told about bookings and subscribers ---------------------------
# Comma-separated. Both of you can be added here.
ADMIN_EMAILS=signatureacte@gmail.com

# --- Signing key for booking tokens and QR codes ----------------------------
# 32+ random characters. Generate one with:  openssl rand -base64 32
# Changing it invalidates every unused confirmation link and QR signature.
BOOKING_SECRET=

# --- Site + payment ---------------------------------------------------------
PUBLIC_SITE_URL=https://signatureacte.com
REVOLUT_CHECKOUT_URL=https://checkout.revolut.com/pay/17f7aafa-d660-4d70-a061-4509a5d6298d

# Set to "true" to email the ticket the moment the form is submitted, without
# waiting for the payment to be checked. Off by default: leaving it off means
# nobody receives a QR code before you have seen their money.
TICKET_ON_BOOKING=false
