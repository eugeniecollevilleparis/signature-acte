---
/**
 * The one-page brief, in either language. Same layout, same styles; only the
 * copy changes, so the two pages can never drift apart.
 */
import { TICKET_PRICE, TICKET_PRICE_FR, WINE_PRICE, WINE_PRICE_FR } from "../lib/event";

export interface Props {
  lang?: "fr" | "en";
}
const { lang = "fr" } = Astro.props;

const SITE = "https://signatureacte.com";
const MAIL = "signatureacte@gmail.com";
const INSTA = "https://www.instagram.com/signature.acte/";

const FR = {
  vision: "SIGNATURE est un lieu où l'architecture, la gastronomie, la musique et la performance dialoguent en parfaite harmonie.",
  where: "Château Laffitte Carcasset · 33180 Saint-Estèphe · Médoc, Bordeaux",
  when: "26 et 27 septembre 2026",
  presale: "Prévente jusqu'au 12 août",
  price: TICKET_PRICE_FR,
  cta: "Réserver ma place →",
  credits: ["Menu signé par la Cheffe ", "Eugénie Colleville", " · Direction artistique par ", "Accard Production"],
  labels: {
    idea: "L'intention",
    who: "Les créateurs",
    welcome: "Le lieu",
    run: "Le déroulé",
    menu: "Le menu",
    included: "Ce qui vous attend le 26",
    extra: "En complément",
    know: "Informations pratiques",
    code: "code d'accès",
  },
  idea: "SIGNATURE est née d'une idée simple : créer un lieu où se retrouvent celles et ceux qui partagent le goût de la gastronomie, des grands vins, du spectacle vivant, de la musique électronique et des rencontres sincères.",
  welcome: "Pour cette première édition, SIGNATURE prend vie au Château Laffitte Carcasset, au cœur de Saint-Estèphe. Une soirée qui se prolonge jusqu'au lendemain, entre gastronomie, musique, architecture et moments partagés, dans un lieu entièrement dédié à cette première rencontre.",
  included: "L'accès à SIGNATURE No. 01, le menu dégustation imaginé par Eugénie Colleville, les artistes DJ, et les performances artistiques.",
  extra: `Une sélection des vins du Château Laffitte Carcasset, à volonté de l'arrivée jusqu'au dîner (${WINE_PRICE_FR}). Brunch du dimanche et hébergement au château, disponibles sur réservation.`,
  acts: [
    ["Acte I · 18:00", "L'arrivée", "Les portes s'ouvrent. Les premiers échanges commencent. Le château révèle son atmosphère."],
    ["Acte II · 19:00", "Golden Hour", "Le soleil se couche sur le domaine. Les canapés font leur entrée. La soirée prend son rythme."],
    ["Acte III · 20:30", "Dîner", "Une création culinaire signée Eugénie Colleville, accompagnée d'une sélection de vins imaginée par Pierre Maussire."],
    ["Acte IV · 22:00", "La Nuit", "La table laisse place aux performances qui se dévoilent. L'atmosphère surprend et change, naturellement."],
    ["Acte V · le lendemain", "Sans précipitation", "Le temps d'un brunch, d'un plongeon, de la relaxation."],
  ],
  menu: [
    ["Apéritif", "Croquettes de jambon de Bayonne, béchamel à l'Ossau-Iraty", "Bulles du Château Laffitte Carcasset", ""],
    ["Canapé I", "Canelé salé au canard confit du Sud-Ouest, compotée de prunes d'Ente", "Bulles du Château Laffitte Carcasset", ""],
    ["Canapé II", "Huître du Bassin d'Arcachon, mignonette au vin rouge du domaine et échalote rose, espuma au vin blanc des Graves", "Bulles du Château Laffitte Carcasset", "Au choix avec le canapé III."],
    ["Canapé III · dans le chai", "Granité de moût de raisin partiellement fermenté du domaine, lait ribot, gelée de Sauternes botrytisé, noix fraîches du Périgord", "Bulles du Château Laffitte Carcasset", "Servi en cuillère porcelaine au cœur des fûts, hommage aux fermentations en cours. Au choix avec le canapé II."],
    ["Pains & beurre · à table", "Pains artisanaux du Sud-Ouest, beurre baratté maison aux algues du littoral atlantique, huile d'olive", "", ""],
    ["Entrée", "Maigre de l'estuaire de la Gironde en gravlax à la verveine citronnée et fenouil sauvage, beurre blanc au vin blanc des Graves servi tiède, pickles du jardin (concombre, fenouil, échalote rose, radis rose), cresson de fontaine, fleur de sel", "Pessac-Léognan blanc", "Contraste froid / tiède signature."],
    ["Plat chaud", "Joue de bœuf de Bazas braisée 6 heures au vin du domaine, écrasé de pomme de terre au gras de canard, jeunes carottes glacées, cèpes confits du Médoc", "Château Laffitte Carcasset, millésime jeune", ""],
    ["Dessert au miel du domaine", "Siphon de yaourt fermier basque, miel du domaine et romarin, gel coulant de figue noire du Sud-Ouest, tuile au sarrasin caramélisée, fleurs comestibles", "Sauternes", ""],
    ["Mignardises", "Pâte de fruit au vin du domaine", "", ""],
    ["Signature", "Tartelette chocolat Majari 64 % Valrhona, caviar Sturia Origin, fleur de sel", "", ""],
  ],
};

const EN = {
  vision: "An evening where architecture, light, sound and the table are one.",
  when: "26 and 27 September 2026",
  where: "Château Laffitte Carcasset · 33180 Saint-Estèphe · Médoc, Bordeaux",
  presale: "Presale until 12 August",
  price: TICKET_PRICE,
  cta: "Reserve my place →",
  credits: ["Menu by chef ", "Eugénie Colleville", " · Music by ", "Accard Production"],
  labels: {
    idea: "The idea",
    who: "By whom",
    welcome: "The place",
    run: "The evening",
    menu: "The menu",
    included: "Included",
    extra: "Ticketed separately",
    know: "Good to know",
    code: "access code",
  },
  idea: "To bring together in one place what usually exists apart: a table, an architecture, a light, a music. Not a dinner followed by a party, but one evening, written from end to end.",
  welcome: "You are received at Château Laffitte Carcasset, one of the oldest estates in Saint-Estèphe, yours alone that night. Dinner served at the table, the night for as long as it lasts, and the next day by the pool.",
  included: "Admission, the tasting menu, the DJ sets and the performances.",
  extra: `The estate wines, unlimited from arrival to dinner (${WINE_PRICE}), Sunday brunch, and the five rooms at the château, on request.`,
  acts: [
    ["Act I · 18:00", "Welcome", "The château gates open, and the evening begins."],
    ["Act II · 19:00", "Golden hour", "Canapés, as the light goes down over the estate."],
    ["Act III · 20:30", "Dinner", "Course by course, wine by wine, chosen by Pierre Maussire."],
    ["Act IV · 22:00", "The Night", "The music takes over. At 23:00 Accard Production takes the act: the show begins, and runs until late."],
    ["Act V · the next day", "No Rush, No Schedule", "Brunch at noon, poolside, and we part at three."],
  ],
  menu: [
    ["Apéritif", "Bayonne ham croquettes, Ossau-Iraty béchamel", "Bulles du Château Laffitte Carcasset", ""],
    ["Canapé I", "Savoury canelé with South-West confit duck, Ente plum compote", "Bulles du Château Laffitte Carcasset", ""],
    ["Canapé II", "Arcachon Bay oyster, mignonette of the estate's red wine and pink shallot, espuma of Graves white wine", "Bulles du Château Laffitte Carcasset", "One or the other, with canapé III."],
    ["Canapé III · in the chai", "Granita of the estate's partially-fermented grape must, ribot milk, botrytised Sauternes jelly, fresh Périgord walnuts", "Bulles du Château Laffitte Carcasset", "Served on a porcelain spoon among the barrels, a nod to the fermentations under way. One or the other, with canapé II."],
    ["Breads & butter · at the table", "Artisan breads from the South-West, house-churned butter with Atlantic seaweed, olive oil", "", ""],
    ["Starter", "Meagre from the Gironde estuary, gravlax with lemon verbena and wild fennel, warm beurre blanc of Graves white wine, garden pickles (cucumber, fennel, pink shallot, pink radish), watercress, fleur de sel", "Pessac-Léognan blanc", "The signature cold-and-warm contrast."],
    ["Hot course", "Bazas beef cheek braised six hours in the estate's wine, crushed potato with duck fat, young glazed carrots, confit Médoc cèpes", "Château Laffitte Carcasset, young vintage", ""],
    ["Dessert · estate honey", "Siphon of Basque farmhouse yoghurt, estate honey and rosemary, flowing gel of South-West black fig, caramelised buckwheat tuile, edible flowers", "Sauternes", ""],
    ["Mignardises", "Pâte de fruit of the estate's wine", "", ""],
    ["Signature", "Majari 64% Valrhona chocolate tartlet, Sturia Origin caviar, fleur de sel", "", ""],
  ],
};

const t = lang === "en" ? EN : FR;
---

<main class="pk">

  <div class="pk__bg" style="background-image: url('/images/signature/act1.jpg');"></div>
  <div class="pk__veil"></div>

  <section class="pk__hero">
    <p class="pk__brand">SIGNATURE</p>
    <p class="pk__no"><em>No. 01</em></p>

    <p class="pk__vision">{t.vision}</p>

    <p class="pk__venue">{t.where.split(" · ")[0]}</p>
    <p class="pk__place">{t.where.split(" · ").slice(1).join(" · ")}</p>
    <p class="pk__when">{t.when}</p>

    <div class="pk__card">
      <p class="pk__c-eyebrow">{t.presale}</p>
      <p class="pk__c-price">{t.price}</p>
      <a class="pk__cta" href={SITE}>{t.cta}</a>
    </div>

    <p class="pk__credits">
      {t.credits[0]}<em>{t.credits[1]}</em>{t.credits[2]}<em>{t.credits[3]}</em>
    </p>
  </section>

  <section class="pk__detail" id="detail">

    <img class="pk__plate" src="/images/signature/act3.jpg" alt="" style="object-position: center 62%;" />

    <div class="pk__block pk__block--split pk__block--first">
      <div>
        <p class="pk__label">{t.labels.idea}</p>
        <p class="pk__plain">{t.idea}</p>
      </div>
      <div>
        <p class="pk__label">{t.labels.who}</p>
        {lang === "en" ? (
          <p class="pk__plain">
            SIGNATURE is imagined by <em>Eugénie Colleville</em> and <em>Tanguy Accard</em>.
            Trained under Alain Ducasse in Paris and London, Eugénie writes the food.
            French-British, Tanguy shapes the art direction, the music and the world of
            each edition through ACCARD Production. The wines are selected by
            <em>Pierre Maussire</em>.
          </p>
        ) : (
          <p class="pk__plain">
            SIGNATURE est imaginée par <em>Eugénie Colleville</em> et <em>Tanguy Accard</em>.
            Formée auprès d'Alain Ducasse à Paris et à Londres, Eugénie signe la création
            culinaire. Franco-britannique, Tanguy imagine la direction artistique, la musique
            et l'univers de chaque édition à travers ACCARD Production. Les vins sont
            sélectionnés par <em>Pierre Maussire</em>.
          </p>
        )}
      </div>
      <div>
        <p class="pk__label">{t.labels.welcome}</p>
        <p class="pk__plain">{t.welcome}</p>
      </div>
    </div>

    <div class="pk__block">
      <p class="pk__label">{t.labels.run}</p>
      <div class="pk__acts">
        {t.acts.map(([kicker, name, line]) => (
          <div class="pk__act">
            <p class="pk__a-kicker">{kicker}</p>
            <p class="pk__a-title">{name}</p>
            <p class="pk__a-line">{line}</p>
          </div>
        ))}
      </div>
    </div>

    <img class="pk__plate" src="/images/signature/act2.jpg" alt="" style="object-position: center 58%;" />

    <div class="pk__block">
      <p class="pk__label">{t.labels.menu}</p>
      <div class="pk__courses">
        {t.menu.map(([course, dish, wine, note]) => (
          <div class="pk__course">
            <p class="pk__c-label">{course}</p>
            {wine && <p class="pk__c-wine"><em>{wine}</em></p>}
            <p class="pk__c-dish">{dish}</p>
            {note && <p class="pk__c-note">{note}</p>}
          </div>
        ))}
      </div>
    </div>

    <img class="pk__plate" src="/images/signature/act5.jpg" alt="" style="object-position: center 78%;" />

    <div class="pk__block pk__block--split">
      <div>
        <p class="pk__label">{t.labels.included}</p>
        <p class="pk__plain">{t.included}</p>
      </div>
      <div>
        <p class="pk__label">{t.labels.extra}</p>
        <p class="pk__plain">{t.extra}</p>
      </div>
      <div>
        <p class="pk__label">{t.labels.know}</p>
        {lang === "en" ? (
          <p class="pk__plain">
            Bordeaux is within reach: <a href={SITE}>drivers and houses to rent</a> are
            listed on the site. Tickets are personal and non-refundable; they may be
            passed on (<a href={`${SITE}/conditions-generales`}>terms of sale</a>).
          </p>
        ) : (
          <p class="pk__plain">
            Bordeaux se situe à moins d'une heure du domaine. Une sélection de chauffeurs,
            d'hébergements et d'informations utiles est disponible <a href={SITE}>sur notre
            site</a>. Chaque invitation est nominative. Les
            <a href={`${SITE}/conditions-generales`}>conditions de réservation</a> sont
            disponibles sur notre site.
          </p>
        )}
      </div>
    </div>

    <footer class="pk__foot">
      <a class="pk__cta" href={SITE}>{t.cta}</a>
      <p class="pk__fine">
        <a href={SITE}>signatureacte.com</a> &nbsp;·&nbsp; {t.labels.code} <strong>carcasset26</strong><br>
        <a href={`mailto:${MAIL}?subject=SIGNATURE%20No.%2001`}>{MAIL}</a>
        &nbsp;·&nbsp; <a href={INSTA} target="_blank" rel="noopener">@signature.acte</a>
      </p>
    </footer>

  </section>
</main>

<style>
  /* Built from the site's own tokens — same veil over the same photograph, the
     same cream on the same ink, the same framed tiles, the same wide-tracked
     micro-caps. Sizes sit at the top of the site's scale: this page is read
     once, on a phone, often in daylight. */
  .pk {
    --sig-ink: #0a0707;
    --sig-cream: #f0e9dd;

    position: relative;
    min-height: 100vh;
    background: var(--sig-ink);
    color: var(--sig-cream);
    padding: clamp(2rem, 7vh, 4.5rem) clamp(1.5rem, 5vw, 4.5rem) clamp(2.5rem, 8vh, 5rem);
  }
  .pk__bg {
    position: fixed;
    inset: 0;
    background-size: cover;
    background-position: center 24%;
    filter: saturate(1.05) contrast(1.04);
    z-index: 0;
  }
  .pk__veil {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg,
      rgba(8, 4, 4, 0.7) 0%, rgba(8, 4, 4, 0.5) 32%,
      rgba(8, 4, 4, 0.68) 66%, rgba(8, 4, 4, 0.88) 100%);
  }
  .pk__hero, .pk__detail { position: relative; z-index: 1; }

  /* ---- Cover ---- */
  .pk__hero {
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
  }
  .pk__brand {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    line-height: 1;
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    color: var(--sig-cream);
    margin: 0;
  }
  .pk__no {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: rgba(240, 233, 221, 0.8);
    margin: 0.55rem 0 0;
  }
  .pk__no em { font-style: italic; }
  .pk__vision {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    line-height: 1.4;
    color: var(--sig-cream);
    max-width: 24em;
    margin: clamp(1.6rem, 4vh, 2.6rem) auto clamp(1.5rem, 3.5vh, 2.2rem);
  }
  .pk__venue {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    letter-spacing: 0.05em;
    color: var(--sig-cream);
    margin: 0 0 0.5rem;
  }
  .pk__place {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.65);
    margin: 0 0 0.6rem;
    padding-left: 0.26em;
  }
  .pk__when {
    font-family: var(--font-body);
    font-size: 0.64rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.75);
    margin: 0;
    padding-left: 0.3em;
  }

  /* The invitation card, verbatim from the cover of the site */
  .pk__card {
    display: inline-block;
    margin: clamp(1.75rem, 4vh, 2.75rem) 0 0;
    padding: 1.5rem 2rem;
    background: rgba(6, 4, 3, 0.45);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(240, 233, 221, 0.22);
  }
  .pk__c-eyebrow {
    font-family: var(--font-body);
    font-size: 0.58rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.65);
    margin: 0 0 0.7rem;
  }
  .pk__c-price {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    color: var(--sig-cream);
    margin: 0 0 1.2rem;
  }
  .pk__cta {
    display: inline-block;
    background: none;
    border: 1px solid rgba(240, 233, 221, 0.4);
    color: var(--sig-cream);
    padding: 0.95rem 1.9rem;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.64rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    transition: border-color 0.35s ease, background 0.35s ease, letter-spacing 0.5s ease;
  }
  .pk__cta:hover {
    border-color: rgba(240, 233, 221, 0.9);
    background: rgba(240, 233, 221, 0.08);
    letter-spacing: 0.38em;
  }
  .pk__credits {
    font-family: var(--font-display);
    font-size: 1rem;
    color: rgba(240, 233, 221, 0.75);
    margin: clamp(1.5rem, 3.5vh, 2.2rem) 0 0;
  }
  .pk__credits em { font-style: italic; color: var(--sig-cream); }

  /* ---- The detail, as the site's tiles ---- */
  .pk__detail {
    max-width: 74rem;
    margin: clamp(2.5rem, 7vh, 4.5rem) auto 0;
    display: grid;
    gap: clamp(1rem, 1.6vw, 1.5rem);
  }
  /* Photographs, in the site's own grade — the page should look like the
     evening, not like a specification. */
  .pk__plate {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border: 1px solid rgba(240, 233, 221, 0.14);
  }
  .pk__block {
    padding: clamp(1.4rem, 2.2vw, 2rem);
    background: rgba(6, 4, 3, 0.4);
    border: 1px solid rgba(240, 233, 221, 0.14);
  }
  .pk__block--split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1.4rem, 2.5vw, 2.5rem);
  }
  .pk__label {
    font-family: var(--font-body);
    font-size: 0.58rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.6);
    margin: 0 0 0.9rem;
    padding-left: 0.4em;
  }
  .pk__plain {
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.6;
    color: rgba(240, 233, 221, 0.85);
    margin: 0;
  }
  .pk__plain em { font-style: italic; color: var(--sig-cream); }

  /* Acts — the Programme blocks */
  .pk__acts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: clamp(1.1rem, 2vw, 1.75rem);
  }
  .pk__a-kicker {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.6);
    margin: 0 0 0.4rem;
  }
  .pk__a-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.3rem;
    line-height: 1.15;
    color: var(--sig-cream);
    margin: 0 0 0.35rem;
  }
  .pk__a-line {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.5;
    color: rgba(240, 233, 221, 0.8);
    margin: 0;
  }

  /* Menu — the Menu courses */
  .pk__courses { columns: 2; column-gap: clamp(1.75rem, 3vw, 3rem); }
  .pk__course {
    break-inside: avoid;
    margin: 0 0 1.1rem;
  }
  .pk__c-label {
    font-family: var(--font-body);
    font-size: 0.58rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.55);
    margin: 0 0 0.3rem;
  }
  .pk__c-dish {
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.5;
    color: rgba(240, 233, 221, 0.9);
    margin: 0;
  }
  .pk__c-wine {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.4;
    color: rgba(240, 233, 221, 0.6);
    margin: 0 0 0.15rem;
  }
  .pk__c-note {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.85rem;
    line-height: 1.4;
    color: rgba(240, 233, 221, 0.5);
    margin: 0.25rem 0 0;
  }

  /* Colophon, as at the foot of the site */
  .pk__foot {
    text-align: center;
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
  }
  .pk__fine {
    margin: 1.4rem 0 0;
    font-family: var(--font-body);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.6);
    line-height: 2.1;
  }
  .pk__fine strong { color: var(--sig-cream); font-weight: 400; }

  .pk a:not(.pk__cta) {
    color: var(--sig-cream);
    text-decoration: none;
    border-bottom: 1px solid rgba(240, 233, 221, 0.35);
    transition: border-color 0.3s ease;
  }
  .pk a:not(.pk__cta):hover { border-bottom-color: rgba(240, 233, 221, 0.9); }

  @media (max-width: 700px) {
    .pk__courses { columns: 1; }
    .pk__plate { aspect-ratio: 4 / 3; }
    .pk__card { display: block; padding: 1.35rem 1.25rem; }
    .pk__cta { display: block; text-align: center; letter-spacing: 0.26em; }
  }

  /* The PDF is the page: same ink, same cream, same photographs. The fixed
     backdrop cannot follow across paged media, so the ground becomes solid
     and the plates carry the image. */
