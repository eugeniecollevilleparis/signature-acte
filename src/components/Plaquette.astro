---
/**
 * The one-page brief, in either language. Same layout, same styles; only the
 * copy changes, so the two pages can never drift apart.
 */
import { TICKET_PRICE, TICKET_PRICE_FR, WINE_PRICE, WINE_PRICE_FR } from "../lib/event";

export interface Props {
  lang?: "fr" | "en";
}
const { lang = "fr" } = Astro.props;

const SITE = "https://signatureacte.com";
const MAIL = "signatureacte@gmail.com";
const INSTA = "https://www.instagram.com/signature.acte/";

const FR = {
  vision: "Une soirée où l'architecture, la lumière, le son et la table ne font qu'un.",
  when: "26 et 27 septembre 2026",
  where: "Château Laffitte Carcasset · Saint-Estèphe · Médoc",
  presale: "Prévente jusqu'au 12 août",
  price: TICKET_PRICE_FR,
  cta: "Réserver ma place →",
  credits: ["Menu de la cheffe ", "Eugénie Colleville", " · Musique par ", "Accard Production"],
  labels: {
    idea: "L'idée",
    who: "Par qui",
    welcome: "Le lieu",
    run: "Le déroulé",
    menu: "Le menu",
    included: "Compris",
    extra: "En supplément",
    know: "Bon à savoir",
    code: "code d'accès",
  },
  idea: "Réunir en un seul lieu ce qui existe d'habitude séparément : une table, une architecture, une lumière, une musique. Pas un dîner suivi d'une fête, mais une soirée écrite d'un bout à l'autre.",
  welcome: "Vous êtes reçus au Château Laffitte Carcasset, l'une des plus anciennes propriétés de Saint-Estèphe, pour vous seuls ce soir-là. Dîner servi à table, la nuit jusqu'au bout, et le lendemain au bord de la piscine.",
  included: "L'entrée, le menu dégustation, les DJ sets et les performances.",
  extra: `Les vins du domaine à volonté, de l'arrivée au dîner (${WINE_PRICE_FR}), le brunch du dimanche, et les cinq chambres du château, sur demande.`,
  acts: [
    ["Acte I · 18:00", "Accueil", "Les grilles du château s'ouvrent, la soirée commence."],
    ["Acte II · 19:00", "Golden Hour", "Les canapés, tandis que la lumière descend sur le domaine."],
    ["Acte III · 20:30", "Dîner", "Plat après plat, vin après vin, choisis par Pierre Maussire."],
    ["Acte IV · 22:00", "La Nuit", "La musique prend la suite, et la nuit trouve son rythme."],
    ["Acte V · le lendemain", "Ni Hâte, Ni Horaire", "Brunch à midi, piscine, et l'on se quitte à quinze heures."],
  ],
  menu: [
    ["Apéritif", "Croquettes de jambon de Bayonne, béchamel à l'Ossau-Iraty", "Crémant du château"],
    ["Canapé I", "Canelé salé au confit de canard, compotée de prunes d'Ente", "Crémant du château"],
    ["Canapé II", "Huître d'Arcachon, mignonnette au vin du domaine, espuma de Graves", "Crémant du château"],
    ["Canapé III · au chai", "Granité de moût du domaine, lait ribot, gelée de Sauternes, noix du Périgord", "Crémant du château"],
    ["À table", "Pains du Sud-Ouest, beurre aux algues baratté maison, huile d'olive", ""],
    ["Entrée", "Maigre de la Gironde en gravlax, verveine et fenouil sauvage, beurre blanc tiède", "Pessac-Léognan blanc"],
    ["Plat", "Joue de bœuf de Bazas braisée six heures au vin de la maison, cèpes du Médoc", "Laffitte Carcasset"],
    ["Dessert", "Yaourt de brebis au miel du domaine et romarin, figue noire, sarrasin caramélisé", "Sauternes"],
    ["Mignardises", "Pâte de fruit au vin de la maison", ""],
    ["Signature", "Tartelette de chocolat pure origine, caviar Sturia®, fleur de sel", ""],
  ],
};

const EN = {
  vision: "An evening where architecture, light, sound and the table are one.",
  when: "26 and 27 September 2026",
  where: "Château Laffitte Carcasset · Saint-Estèphe · Médoc",
  presale: "Presale until 12 August",
  price: TICKET_PRICE,
  cta: "Reserve my place →",
  credits: ["Menu by chef ", "Eugénie Colleville", " · Music by ", "Accard Production"],
  labels: {
    idea: "The idea",
    who: "By whom",
    welcome: "The place",
    run: "The evening",
    menu: "The menu",
    included: "Included",
    extra: "Ticketed separately",
    know: "Good to know",
    code: "access code",
  },
  idea: "To bring together in one place what usually exists apart: a table, an architecture, a light, a music. Not a dinner followed by a party, but one evening, written from end to end.",
  welcome: "You are received at Château Laffitte Carcasset, one of the oldest estates in Saint-Estèphe, yours alone that night. Dinner served at the table, the night for as long as it lasts, and the next day by the pool.",
  included: "Admission, the tasting menu, the DJ sets and the performances.",
  extra: `The estate wines, unlimited from arrival to dinner (${WINE_PRICE}), Sunday brunch, and the five rooms at the château, on request.`,
  acts: [
    ["Act I · 18:00", "Welcome", "The château gates open, and the evening begins."],
    ["Act II · 19:00", "Golden hour", "Canapés, as the light goes down over the estate."],
    ["Act III · 20:30", "Dinner", "Course by course, wine by wine, chosen by Pierre Maussire."],
    ["Act IV · 22:00", "The Night", "The music takes over, and the night finds its own rhythm."],
    ["Act V · the next day", "No Rush, No Schedule", "Brunch at noon, poolside, and we part at three."],
  ],
  menu: [
    ["Apéritif", "Bayonne ham croquettes, Ossau-Iraty béchamel", "the château's Crémant"],
    ["Canapé I", "Savoury canelé with confit duck, Ente plum compote", "the château's Crémant"],
    ["Canapé II", "Arcachon oyster, mignonette of the estate's red, Graves espuma", "the château's Crémant"],
    ["Canapé III · in the chai", "Granita of the estate's grape must, ribot milk, Sauternes jelly, Périgord walnuts", "the château's Crémant"],
    ["At the table", "South-West breads, house-churned seaweed butter, olive oil", ""],
    ["Starter", "Gironde meagre gravlax, lemon verbena and wild fennel, warm beurre blanc", "Pessac-Léognan blanc"],
    ["Main", "Bazas beef cheek braised six hours in the house wine, Médoc cèpes", "Laffitte Carcasset"],
    ["Dessert", "Sheep's yoghurt with estate honey and rosemary, black fig, caramelised buckwheat", "Sauternes"],
    ["Mignardises", "Pâte de fruit of the house wine", ""],
    ["Signature", "Single-origin dark chocolate tartlet, Sturia® caviar, fleur de sel", ""],
  ],
};

const t = lang === "en" ? EN : FR;
---

<main class="pk">

  <div class="pk__bg" style="background-image: url('/images/signature/act1.jpg');"></div>
  <div class="pk__veil"></div>

  <section class="pk__hero">
    <p class="pk__brand">SIGNATURE</p>
    <p class="pk__no"><em>No. 01</em></p>

    <p class="pk__vision">{t.vision}</p>

    <p class="pk__venue">{t.where.split(" · ")[0]}</p>
    <p class="pk__place">{t.where.split(" · ").slice(1).join(" · ")}</p>
    <p class="pk__when">{t.when}</p>

    <div class="pk__card">
      <p class="pk__c-eyebrow">{t.presale}</p>
      <p class="pk__c-price">{t.price}</p>
      <a class="pk__cta" href={SITE}>{t.cta}</a>
    </div>

    <p class="pk__credits">
      {t.credits[0]}<em>{t.credits[1]}</em>{t.credits[2]}<em>{t.credits[3]}</em>
    </p>
  </section>

  <section class="pk__detail" id="detail">

    <img class="pk__plate" src="/images/signature/act3.jpg" alt="" style="object-position: center 62%;" />

    <div class="pk__block pk__block--split pk__block--first">
      <div>
        <p class="pk__label">{t.labels.idea}</p>
        <p class="pk__plain">{t.idea}</p>
      </div>
      <div>
        <p class="pk__label">{t.labels.who}</p>
        <p class="pk__plain">
          <em>Eugénie Colleville</em>{lang === "en" ? ", chef, writes the menu. " : ", cheffe, signe le menu. "}
          <em>Tanguy Accard</em>{lang === "en"
            ? ", creative direction, shapes the atmosphere and the music with Accard Production. The wines are chosen by "
            : ", direction créative, signe l'atmosphère et la musique avec Accard Production. Les vins sont choisis par "}
          <em>Pierre Maussire</em>.
        </p>
      </div>
      <div>
        <p class="pk__label">{t.labels.welcome}</p>
        <p class="pk__plain">{t.welcome}</p>
      </div>
    </div>

    <div class="pk__block">
      <p class="pk__label">{t.labels.run}</p>
      <div class="pk__acts">
        {t.acts.map(([kicker, name, line]) => (
          <div class="pk__act">
            <p class="pk__a-kicker">{kicker}</p>
            <p class="pk__a-title">{name}</p>
            <p class="pk__a-line">{line}</p>
          </div>
        ))}
      </div>
    </div>

    <img class="pk__plate" src="/images/signature/act2.jpg" alt="" style="object-position: center 58%;" />

    <div class="pk__block">
      <p class="pk__label">{t.labels.menu}</p>
      <div class="pk__courses">
        {t.menu.map(([course, dish, wine]) => (
          <div class="pk__course">
            <p class="pk__c-label">{course}</p>
            <p class="pk__c-dish">{dish}</p>
            {wine && <p class="pk__c-wine"><em>{wine}</em></p>}
          </div>
        ))}
      </div>
    </div>

    <img class="pk__plate" src="/images/signature/act5.jpg" alt="" style="object-position: center 78%;" />

    <div class="pk__block pk__block--split">
      <div>
        <p class="pk__label">{t.labels.included}</p>
        <p class="pk__plain">{t.included}</p>
      </div>
      <div>
        <p class="pk__label">{t.labels.extra}</p>
        <p class="pk__plain">{t.extra}</p>
      </div>
      <div>
        <p class="pk__label">{t.labels.know}</p>
        {lang === "en" ? (
          <p class="pk__plain">
            Bordeaux is within reach: <a href={SITE}>drivers and houses to rent</a> are
            listed on the site. Tickets are personal and non-refundable; they may be
            passed on (<a href={`${SITE}/conditions-generales`}>terms of sale</a>).
          </p>
        ) : (
          <p class="pk__plain">
            Bordeaux est à portée : <a href={SITE}>chauffeurs et maisons à louer</a> sont
            listés sur le site. Billet nominatif, non remboursable, cessible
            (<a href={`${SITE}/conditions-generales`}>conditions de vente</a>).
          </p>
        )}
      </div>
    </div>

    <footer class="pk__foot">
      <a class="pk__cta" href={SITE}>{t.cta}</a>
      <p class="pk__fine">
        <a href={SITE}>signatureacte.com</a> &nbsp;·&nbsp; {t.labels.code} <strong>carcasset26</strong><br>
        <a href={`mailto:${MAIL}?subject=SIGNATURE%20No.%2001`}>{MAIL}</a>
        &nbsp;·&nbsp; <a href={INSTA} target="_blank" rel="noopener">@signature.acte</a>
      </p>
    </footer>

  </section>
</main>

<style>
  /* Built from the site's own tokens — same veil over the same photograph, the
     same cream on the same ink, the same framed tiles, the same wide-tracked
     micro-caps. Sizes sit at the top of the site's scale: this page is read
     once, on a phone, often in daylight. */
  .pk {
    --sig-ink: #0a0707;
    --sig-cream: #f0e9dd;

    position: relative;
    min-height: 100vh;
    background: var(--sig-ink);
    color: var(--sig-cream);
    padding: clamp(2rem, 7vh, 4.5rem) clamp(1.5rem, 5vw, 4.5rem) clamp(2.5rem, 8vh, 5rem);
  }
  .pk__bg {
    position: fixed;
    inset: 0;
    background-size: cover;
    background-position: center 24%;
    filter: saturate(1.05) contrast(1.04);
    z-index: 0;
  }
  .pk__veil {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg,
      rgba(8, 4, 4, 0.7) 0%, rgba(8, 4, 4, 0.5) 32%,
      rgba(8, 4, 4, 0.68) 66%, rgba(8, 4, 4, 0.88) 100%);
  }
  .pk__hero, .pk__detail { position: relative; z-index: 1; }

  /* ---- Cover ---- */
  .pk__hero {
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
  }
  .pk__brand {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    line-height: 1;
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    color: var(--sig-cream);
    margin: 0;
  }
  .pk__no {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: rgba(240, 233, 221, 0.8);
    margin: 0.55rem 0 0;
  }
  .pk__no em { font-style: italic; }
  .pk__vision {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    line-height: 1.4;
    color: var(--sig-cream);
    max-width: 24em;
    margin: clamp(1.6rem, 4vh, 2.6rem) auto clamp(1.5rem, 3.5vh, 2.2rem);
  }
  .pk__venue {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    letter-spacing: 0.05em;
    color: var(--sig-cream);
    margin: 0 0 0.5rem;
  }
  .pk__place {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.65);
    margin: 0 0 0.6rem;
    padding-left: 0.26em;
  }
  .pk__when {
    font-family: var(--font-body);
    font-size: 0.64rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.75);
    margin: 0;
    padding-left: 0.3em;
  }

  /* The invitation card, verbatim from the cover of the site */
  .pk__card {
    display: inline-block;
    margin: clamp(1.75rem, 4vh, 2.75rem) 0 0;
    padding: 1.5rem 2rem;
    background: rgba(6, 4, 3, 0.45);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(240, 233, 221, 0.22);
  }
  .pk__c-eyebrow {
    font-family: var(--font-body);
    font-size: 0.58rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.65);
    margin: 0 0 0.7rem;
  }
  .pk__c-price {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    color: var(--sig-cream);
    margin: 0 0 1.2rem;
  }
  .pk__cta {
    display: inline-block;
    background: none;
    border: 1px solid rgba(240, 233, 221, 0.4);
    color: var(--sig-cream);
    padding: 0.95rem 1.9rem;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.64rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    transition: border-color 0.35s ease, background 0.35s ease, letter-spacing 0.5s ease;
  }
  .pk__cta:hover {
    border-color: rgba(240, 233, 221, 0.9);
    background: rgba(240, 233, 221, 0.08);
    letter-spacing: 0.38em;
  }
  .pk__credits {
    font-family: var(--font-display);
    font-size: 1rem;
    color: rgba(240, 233, 221, 0.75);
    margin: clamp(1.5rem, 3.5vh, 2.2rem) 0 0;
  }
  .pk__credits em { font-style: italic; color: var(--sig-cream); }

  /* ---- The detail, as the site's tiles ---- */
  .pk__detail {
    max-width: 74rem;
    margin: clamp(2.5rem, 7vh, 4.5rem) auto 0;
    display: grid;
    gap: clamp(1rem, 1.6vw, 1.5rem);
  }
  /* Photographs, in the site's own grade — the page should look like the
     evening, not like a specification. */
  .pk__plate {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border: 1px solid rgba(240, 233, 221, 0.14);
  }
  .pk__block {
    padding: clamp(1.4rem, 2.2vw, 2rem);
    background: rgba(6, 4, 3, 0.4);
    border: 1px solid rgba(240, 233, 221, 0.14);
  }
  .pk__block--split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1.4rem, 2.5vw, 2.5rem);
  }
  .pk__label {
    font-family: var(--font-body);
    font-size: 0.58rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.6);
    margin: 0 0 0.9rem;
    padding-left: 0.4em;
  }
  .pk__plain {
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.6;
    color: rgba(240, 233, 221, 0.85);
    margin: 0;
  }
  .pk__plain em { font-style: italic; color: var(--sig-cream); }

  /* Acts — the Programme blocks */
  .pk__acts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: clamp(1.1rem, 2vw, 1.75rem);
  }
  .pk__a-kicker {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.6);
    margin: 0 0 0.4rem;
  }
  .pk__a-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.3rem;
    line-height: 1.15;
    color: var(--sig-cream);
    margin: 0 0 0.35rem;
  }
  .pk__a-line {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.5;
    color: rgba(240, 233, 221, 0.8);
    margin: 0;
  }

  /* Menu — the Menu courses */
  .pk__courses { columns: 2; column-gap: clamp(1.75rem, 3vw, 3rem); }
  .pk__course {
    break-inside: avoid;
    margin: 0 0 1.1rem;
  }
  .pk__c-label {
    font-family: var(--font-body);
    font-size: 0.58rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.55);
    margin: 0 0 0.3rem;
  }
  .pk__c-dish {
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.5;
    color: rgba(240, 233, 221, 0.9);
    margin: 0;
  }
  .pk__c-wine {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.4;
    color: rgba(240, 233, 221, 0.6);
    margin: 0.15rem 0 0;
  }

  /* Colophon, as at the foot of the site */
  .pk__foot {
    text-align: center;
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
  }
  .pk__fine {
    margin: 1.4rem 0 0;
    font-family: var(--font-body);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.6);
    line-height: 2.1;
  }
  .pk__fine strong { color: var(--sig-cream); font-weight: 400; }

  .pk a:not(.pk__cta) {
    color: var(--sig-cream);
    text-decoration: none;
    border-bottom: 1px solid rgba(240, 233, 221, 0.35);
    transition: border-color 0.3s ease;
  }
  .pk a:not(.pk__cta):hover { border-bottom-color: rgba(240, 233, 221, 0.9); }

  @media (max-width: 700px) {
    .pk__courses { columns: 1; }
    .pk__plate { aspect-ratio: 4 / 3; }
    .pk__card { display: block; padding: 1.35rem 1.25rem; }
    .pk__cta { display: block; text-align: center; letter-spacing: 0.26em; }
  }

  /* Printed: the same layout, on paper. */
  @media print {
    .pk {
      background: #fff;
      color: #17120f;
      padding: 0;
      min-height: 0;
    }
    .pk__bg, .pk__veil { display: none; }
    .pk__brand, .pk__vision, .pk__venue, .pk__c-price, .pk__a-title { color: #17120f; }
    .pk__no, .pk__when, .pk__place, .pk__label, .pk__a-kicker, .pk__c-label,
    .pk__c-eyebrow, .pk__fine, .pk__credits { color: #6d5e53; }
    .pk__plain, .pk__a-line, .pk__c-dish { color: #3a2f28; }
    .pk__c-wine { color: #6d5e53; }
    .pk__credits em, .pk__plain em, .pk__fine strong { color: #17120f; }
    .pk__plate { aspect-ratio: 16 / 6; border-color: #d9cfc0; break-inside: avoid; }
    .pk__block, .pk__card {
      background: none;
      border-color: #d9cfc0;
      backdrop-filter: none;
    }
    .pk__cta { border-color: #17120f; color: #17120f; }
    .pk a:not(.pk__cta) { color: #17120f; border-bottom-color: #b3a89f; }
  }
</style>
