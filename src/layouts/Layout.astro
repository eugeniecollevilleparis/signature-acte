---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = "SIGNATURE, No. 01 · 26-27 September 2026 · Château Laffitte Carcasset",
  description = "Signature No. 01, 26-27 September 2026 at Château Laffitte Carcasset, Saint-Estèphe. An evening where architecture, light, sound, gastronomy, conversation and performance are conceived as one.",
  lang = "en",
} = Astro.props;

// WhatsApp, iMessage and LinkedIn all refuse relative image paths in a link
// preview, so these are resolved against `site` in astro.config.mjs.
const ogImage = new URL("/og-signature.jpg", Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon-256.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Theme color -->
    <meta name="theme-color" content="#0f0d0c" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SIGNATURE" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Château Laffitte Carcasset at dusk — SIGNATURE No. 01" />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_GB"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="fr" href="/fr" />
    <link rel="alternate" hreflang="x-default" href="/" />

    <!-- Preconnect fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <body>
    <slot />

    <!-- Smooth scroll (Lenis) -->
    <script>
      import Lenis from "lenis";

      // The tabbed experience locks the page (body overflow:hidden) and scrolls
      // inside its own panels and dialog. Lenis would swallow every wheel event
      // to drive a page scroll that cannot move, leaving those inner areas
      // unscrollable by mouse. Only run it on pages that actually scroll.
      const isLockedPage = !!document.querySelector(".sigt");

      const lenis = isLockedPage
        ? null
        : new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smoothWheel: true,
          });

      // Expose globally so other components (e.g. back-to-top) can use it
      (window as any).__lenis = lenis;

      if (lenis) {
        const smooth = lenis;
        const raf = (time: number) => {
          smooth.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);

        // Anchor links — use Lenis for smooth scroll to anchors
        document.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          const anchor = target.closest('a[href^="#"]') as HTMLAnchorElement | null;
          if (!anchor) return;
          const id = anchor.getAttribute("href");
          if (!id || id === "#") return;
          const el = document.querySelector(id);
          if (!el) return;
          e.preventDefault();
          smooth.scrollTo(el as HTMLElement, { offset: 0, duration: 1.4 });
        });
      }
    </script>

    <!-- Reveal-on-scroll (re-triggers every time element enters/leaves viewport) -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
            } else {
              // Only reset if the element has fully left the viewport (top is below screen
              // or bottom is above screen) so that elements scrolled slightly out and back
              // do not flicker.
              const rect = entry.boundingClientRect;
              const fullyOut = rect.bottom < 0 || rect.top > window.innerHeight;
              if (fullyOut) {
                entry.target.classList.remove("is-visible");
              }
            }
          });
        },
        { threshold: [0, 0.12, 1], rootMargin: "0px 0px -8% 0px" },
      );

      document
        .querySelectorAll("[data-reveal], [data-reveal-image]")
        .forEach((el) => observer.observe(el));
    </script>

    <!-- Header scroll behavior -->
    <script>
      let lastY = 0;
      const header = document.querySelector("[data-nav]") as HTMLElement | null;
      if (header) {
        window.addEventListener(
          "scroll",
          () => {
            const y = window.scrollY;
            if (y > 80) header.classList.add("is-scrolled");
            else header.classList.remove("is-scrolled");
            if (y > lastY && y > 200) header.classList.add("is-hidden");
            else header.classList.remove("is-hidden");
            lastY = y;
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>

<style is:global>
  html.lenis,
  html.lenis body {
    height: auto;
  }
  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }
  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }
  .lenis.lenis-stopped {
    overflow: hidden;
  }
</style>
