---
import Layout from "../layouts/Layout.astro";
import { TICKET_PRICE_FR, WINE_PRICE_FR } from "../lib/event";

const title = "SIGNATURE, No. 01 — la soirée en une page";
const description =
  "26-27 septembre 2026, Château Laffitte Carcasset, Saint-Estèphe. Une soirée, une table, de dix-huit heures au lendemain quinze heures.";

const SITE = "https://signatureacte.com";
const MAIL = "signatureacte@gmail.com";
const INSTA = "https://www.instagram.com/signature.acte/";
---

<Layout lang="fr" title={title} description={description}>
  <main class="pk">
    <div class="pk__bg" style="background-image: url('/images/signature/act1.jpg');"></div>
    <div class="pk__veil"></div>

    <article class="pk__sheet">

      <header class="pk__head">
        <p class="pk__brand">SIGNATURE</p>
        <p class="pk__no"><em>No. 01</em></p>
        <p class="pk__when">26 – 27 septembre 2026 &nbsp;·&nbsp; Château Laffitte Carcasset</p>
        <p class="pk__where">Saint-Estèphe · Médoc · Bordeaux</p>
      </header>

      <p class="pk__lead">
        Une soirée où l'architecture, la lumière, le son, la gastronomie, la
        conversation et la performance sont pensés comme un seul geste. Une
        table, un château pour nous seuls, et une nuit qui va de dix-huit heures
        au lendemain quinze heures.
      </p>

      <section class="pk__grid">
        <div class="pk__col">
          <p class="pk__label">La soirée</p>
          <ul class="pk__list">
            <li><span>18:00</span> Ouverture des grilles, verre d'accueil</li>
            <li><span>19:00</span> Canapés, à la tombée du jour</li>
            <li><span>20:30</span> Dîner, plat après plat</li>
            <li><span>22:00</span> La nuit — DJ sets jusqu'au bout</li>
            <li><span>12:00</span> Dimanche, brunch au bord de la piscine</li>
            <li><span>15:00</span> Rideau</li>
          </ul>
        </div>

        <div class="pk__col">
          <p class="pk__label">Le billet comprend</p>
          <ul class="pk__list pk__list--plain">
            <li>L'entrée, pour une personne</li>
            <li>Le menu dégustation de saison</li>
            <li>Les DJ sets et les performances</li>
            <li>Le verre d'accueil</li>
          </ul>
          <p class="pk__label pk__label--sep">En supplément</p>
          <ul class="pk__list pk__list--plain">
            <li>Les vins du domaine, en accord — {WINE_PRICE_FR}</li>
            <li>Le brunch du dimanche</li>
            <li>Les chambres du château — cinq, sur demande</li>
          </ul>
        </div>

        <div class="pk__col">
          <p class="pk__label">Bon à savoir</p>
          <ul class="pk__list pk__list--plain">
            <li>Saint-Estèphe est à portée de Bordeaux — chauffeurs et navettes sont <a href={SITE}>listés sur le site</a>.</li>
            <li>C'est la semaine des vendanges dans le Médoc — maisons à louer à côté, du vendredi au lundi.</li>
            <li>Tenue : celle d'un long dîner qui se transforme en nuit.</li>
            <li>Le billet est nominatif et non remboursable ; il peut être cédé. <a href={`${SITE}/conditions-generales`}>Conditions de vente</a>.</li>
          </ul>
        </div>
      </section>

      <footer class="pk__foot">
        <p class="pk__price"><span>Prévente jusqu'au 12 août</span><strong>{TICKET_PRICE_FR}</strong></p>
        <a class="pk__cta" href={SITE}>Réserver ma place →</a>
        <p class="pk__fine">
          <a href={SITE}>signatureacte.com</a> &nbsp;·&nbsp; code d'accès <em>carcasset26</em><br>
          <a href={`mailto:${MAIL}?subject=SIGNATURE%20No.%2001`}>{MAIL}</a>
          &nbsp;·&nbsp; <a href={INSTA} target="_blank" rel="noopener">@signature.acte</a>
        </p>
      </footer>

    </article>
  </main>
</Layout>

<style>
  .pk {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.25rem, 4vw, 3rem);
    background: var(--sig-ink, #0a0707);
  }
  .pk__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 22%;
  }
  .pk__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 4, 4, 0.62) 0%, rgba(8, 4, 4, 0.86) 100%);
  }
  .pk__sheet {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 62rem;
    padding: clamp(1.5rem, 3.5vw, 3rem);
    border: 1px solid rgba(240, 233, 221, 0.16);
    background: rgba(6, 4, 3, 0.55);
    backdrop-filter: blur(2px);
    color: var(--sig-cream, #f0e9dd);
  }

  .pk__head { text-align: center; }
  .pk__brand {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 3.2rem);
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    margin: 0;
    line-height: 1;
  }
  .pk__no {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.6vw, 1.2rem);
    color: rgba(240, 233, 221, 0.8);
    margin: 0.45rem 0 1.1rem;
  }
  .pk__when {
    font-family: var(--font-body);
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin: 0 0 0.35rem;
  }
  .pk__where {
    font-family: var(--font-body);
    font-size: 0.58rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.6);
    margin: 0;
  }

  .pk__lead {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.6;
    text-align: center;
    max-width: 40rem;
    margin: clamp(1.4rem, 3vh, 2.2rem) auto;
    color: rgba(240, 233, 221, 0.9);
  }

  .pk__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    border-top: 1px solid rgba(240, 233, 221, 0.16);
    padding-top: clamp(1.25rem, 3vh, 2rem);
  }
  .pk__label {
    font-family: var(--font-body);
    font-size: 0.55rem;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.55);
    margin: 0 0 0.9rem;
  }
  .pk__label--sep { margin-top: 1.4rem; }
  .pk__list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(240, 233, 221, 0.85);
  }
  .pk__list li { margin: 0 0 0.55rem; }
  .pk__list span {
    display: inline-block;
    min-width: 3.4em;
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    color: rgba(240, 233, 221, 0.55);
  }
  .pk__list--plain li { padding-left: 0.9em; text-indent: -0.9em; }
  .pk__list--plain li::before { content: "— "; color: rgba(240, 233, 221, 0.4); }

  .pk__foot {
    margin-top: clamp(1.4rem, 3vh, 2.2rem);
    padding-top: clamp(1.1rem, 2.5vh, 1.6rem);
    border-top: 1px solid rgba(240, 233, 221, 0.16);
    text-align: center;
  }
  .pk__price { margin: 0 0 1rem; }
  .pk__price span {
    display: block;
    font-family: var(--font-body);
    font-size: 0.55rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.55);
    margin-bottom: 0.35rem;
  }
  .pk__price strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    letter-spacing: 0.04em;
  }
  .pk__cta {
    display: inline-block;
    padding: 0.85rem 2.2rem;
    background: var(--sig-cream, #f0e9dd);
    color: var(--sig-ink, #0a0707);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    transition: letter-spacing 0.5s ease, opacity 0.3s ease;
  }
  .pk__cta:hover { letter-spacing: 0.4em; opacity: 0.9; }
  .pk__fine {
    margin: 1.1rem 0 0;
    font-family: var(--font-body);
    font-size: 0.55rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.5);
    line-height: 2;
  }
  .pk__fine em { font-style: normal; color: rgba(240, 233, 221, 0.8); }
  .pk a:not(.pk__cta) {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(240, 233, 221, 0.35);
    transition: border-color 0.3s ease, color 0.3s ease;
  }
  .pk a:not(.pk__cta):hover { color: var(--sig-cream, #f0e9dd); border-bottom-color: rgba(240, 233, 221, 0.9); }

  @media (max-width: 860px) {
    .pk__grid { grid-template-columns: 1fr; gap: 1.4rem; }
    .pk__list { font-size: 0.98rem; }
  }

  /* One sheet of A4, ink-friendly. */
  @media print {
    .pk { min-height: 0; padding: 0; background: #fff; }
    .pk__bg, .pk__veil { display: none; }
    .pk__sheet {
      max-width: none;
      border: none;
      background: none;
      color: #14100e;
      padding: 0;
      backdrop-filter: none;
    }
    .pk__lead, .pk__list { color: #2a221e; }
    .pk__where, .pk__label, .pk__fine, .pk__price span, .pk__list span { color: #6b5c53; }
    .pk__grid, .pk__foot { border-color: #cfc4bb; }
    .pk__cta { background: none; color: #14100e; border: 1px solid #14100e; padding: 0.5rem 1.2rem; }
    .pk a:not(.pk__cta) { border-bottom-color: #b3a89f; }
  }
</style>
