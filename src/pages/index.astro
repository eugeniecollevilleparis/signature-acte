  }
  .sigt-colophon a:hover { color: #fff; border-color: rgba(240, 233, 221, 0.8); }

  /* ============ ARROWS ============ */
  .sigt-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    background: none;
    border: 1px solid rgba(240, 233, 221, 0.25);
    color: rgba(240, 233, 221, 0.75);
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    font-size: 1rem;
    cursor: pointer;
    transition: border-color 0.35s ease, color 0.35s ease, background 0.35s ease, opacity 0.4s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sigt-arrow:hover {
    border-color: rgba(240, 233, 221, 0.85);
    color: var(--sig-cream);
    background: rgba(240, 233, 221, 0.07);
  }
  .sigt-arrow--prev { left: clamp(0.8rem, 2vw, 2rem); }
  .sigt-arrow--next { right: clamp(0.8rem, 2vw, 2rem); }
  .sigt-arrow[disabled] { opacity: 0; pointer-events: none; }

  /* ============ GATE + CEREMONY (unchanged look) ============ */
  .sig-gate {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--sig-ink);
    overflow: hidden;
    opacity: 1;
    transition: opacity 0.6s ease;
  }
  .sig-gate[aria-hidden="true"] { opacity: 0; pointer-events: none; }
  .sig-gate__bg {
    position: absolute;
    inset: 0;
    filter: blur(2px) brightness(0.45);
    z-index: 0;
    overflow: hidden;
  }
  .sig-gate__bg--video video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
  }
  .sig-gate__bg--video::after {
    content: "";
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at center, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.75) 80%);
    pointer-events: none;
  }
  .sig-gate__inner {
    position: relative; z-index: 1;
    text-align: center;
    color: var(--sig-cream);
    padding: 2rem;
    max-width: 28rem;
  }
  .sig-gate__brand {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    letter-spacing: 0.35em;
    text-indent: 0.35em;
    margin: 0 0 0.75rem;
  }
  .sig-gate__sub {
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.7);
    margin: 0 0 2.5rem;
  }
  .sig-gate__form { display: flex; gap: 0.5rem; justify-content: center; }
  .sig-gate__form input {
    background: rgba(240, 233, 221, 0.08);
    border: 1px solid rgba(240, 233, 221, 0.35);
    color: var(--sig-cream);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.05em;
    padding: 0.85rem 1rem;
    width: 14rem;
    text-align: center;
    outline: none;
    transition: border-color 0.3s ease;
  }
  .sig-gate__form input::placeholder { color: rgba(240, 233, 221, 0.4); }
  .sig-gate__form input:focus { border-color: rgba(240, 233, 221, 0.85); }
  .sig-gate__form button {
    background: var(--sig-cream);
    color: var(--sig-ink);
    border: none;
    padding: 0.85rem 1.4rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }
  .sig-gate__form button:hover { opacity: 0.85; }
  .sig-gate__err {
    min-height: 1.2em;
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    color: rgba(240, 233, 221, 0.7);
  }

  .sig-ceremony {
    position: fixed;
    inset: 0;
    z-index: 9998;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
  }
  .sig-ceremony[aria-hidden="false"] { animation: sigCeremony 1.4s ease-out forwards; }
  .sig-ceremony::before {
    content: "SIGNATURE";
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.4rem, 3.2vw, 2.4rem);
    letter-spacing: 0.5em;
    text-indent: 0.5em;
    color: var(--sig-cream);
    opacity: 0;
    text-transform: uppercase;
  }
  .sig-ceremony[aria-hidden="false"]::before { animation: sigCeremonyText 1.4s ease-out forwards; }
  @keyframes sigCeremony {
    0% { opacity: 1; }
    75% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes sigCeremonyText {
    0% { opacity: 0; letter-spacing: 0.8em; text-indent: 0.8em; }
    30% { opacity: 1; letter-spacing: 0.5em; text-indent: 0.5em; }
    75% { opacity: 1; letter-spacing: 0.5em; text-indent: 0.5em; }
    100% { opacity: 0; letter-spacing: 0.4em; text-indent: 0.4em; }
  }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 900px) {
    .sigt__bar { flex-direction: column; align-items: flex-start; gap: 0.6rem; }
    .sigt__tabs { width: 100%; }
    .sigt-panel__inner { padding-top: clamp(6.5rem, 15vh, 8rem); }
    .sigt-panel__inner--split { flex-direction: column; align-items: stretch; gap: 2rem; overflow-y: auto; scrollbar-width: none; }
    .sigt-panel__inner--split::-webkit-scrollbar { display: none; }
    .sigt-menu { grid-template-columns: 1fr; gap: 0.5rem; }
    .sigt-days { grid-template-columns: 1fr; gap: 2rem; }
    .sigt-creators { grid-template-columns: 1fr; gap: 1rem; }
    .sigt-contact { grid-template-columns: 1fr; gap: 1rem; }
    .sigt-cover__row { flex-direction: column; align-items: stretch; }
    .sigt-arrow { display: none; }
  }

  @media (max-width: 600px) {
    .sig-gate__form { flex-direction: column; }
    .sig-gate__form input { width: 100%; }
  }
</style>

<script>
  // ===== Passcode gate =====
  const gate = document.getElementById("sigGate") as HTMLElement | null;
  const main = document.getElementById("sigMain") as HTMLElement | null;
  const form = document.getElementById("sigGateForm") as HTMLFormElement | null;
  const input = document.getElementById("sigGateInput") as HTMLInputElement | null;
  const err = document.getElementById("sigGateErr") as HTMLElement | null;
  const ceremony = document.getElementById("sigCeremony") as HTMLElement | null;

  const unlock = (withCeremony = true) => {
    if (!gate || !main) return;
    main.hidden = false;
    gate.setAttribute("aria-hidden", "true");
    setTimeout(() => gate.remove(), 700);
    try { sessionStorage.setItem("sigUnlocked", "1"); } catch {}
    if (withCeremony && ceremony) {
      ceremony.setAttribute("aria-hidden", "false");
      setTimeout(() => ceremony.remove(), 1500);
    } else if (ceremony) {
      ceremony.remove();
    }
    // Reveal cover content
    activate("invitation", true);
  };

  // ===== Tabs engine — fullscreen panels, no scroll =====
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".sigt__tab"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>(".sigt-panel"));
  const order = tabs.map((t) => t.dataset.tab!);
  let current = "invitation";
  let switching = false;

  // Auto-scroll the Menu so guests see every course, ending on the Signature tartlet
  let menuScrollRAF = 0;
  function autoScrollMenu(p: HTMLElement) {
    const scroller = p.querySelector<HTMLElement>(".sigt-panel__inner--scrollable");
    if (!scroller) return;
    cancelAnimationFrame(menuScrollRAF);
    const startAt = performance.now() + 2200;
    const cancel = () => cancelAnimationFrame(menuScrollRAF);
    scroller.addEventListener("wheel", cancel, { once: true, passive: true });
    scroller.addEventListener("touchstart", cancel, { once: true, passive: true });
    const stepScroll = (now: number) => {
      const dist = scroller.scrollHeight - scroller.clientHeight;
      if (now >= startAt) {
        const y = Math.min(dist, ((now - startAt) / 1000) * 34);
        scroller.scrollTop = y;
        if (y >= dist) return;
      }
      menuScrollRAF = requestAnimationFrame(stepScroll);
    };
    menuScrollRAF = requestAnimationFrame(stepScroll);
  }

  function activate(name: string, force = false) {
    if (!force && (switching || name === current)) return;
    if (!order.includes(name)) return;
    switching = true;
    current = name;

    tabs.forEach((t) => {
      const on = t.dataset.tab === name;
      t.classList.toggle("is-active", on);
      t.setAttribute("aria-selected", on ? "true" : "false");
    });
    panels.forEach((p) => {
      const on = p.dataset.panel === name;
      p.classList.toggle("is-active", on);
      // Retrigger the reveals inside the newly-active panel
      if (on) {
        p.querySelectorAll("[data-reveal]").forEach((el) => el.classList.remove("is-visible"));
        requestAnimationFrame(() => {
          setTimeout(() => {
            p.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("is-visible"));
          }, 120);
        });
        // Reset internal scroll of the panel
        const scroller = p.querySelector<HTMLElement>(".sigt-panel__inner--scrollable, .sigt-panel__inner--split");
        if (scroller) scroller.scrollTop = 0;
        if (name === "menu") autoScrollMenu(p);
        else cancelAnimationFrame(menuScrollRAF);
      } else {
        p.querySelectorAll("[data-reveal]").forEach((el) => el.classList.remove("is-visible"));
      }
    });

    // Progress bar mirrors the tab position
    const bar = document.querySelector<HTMLElement>(".sig-progress > span");
    if (bar) bar.style.width = `${((order.indexOf(name) + 1) / order.length) * 100}%`;

    // Arrows enable/disable at the ends
    const prev = document.querySelector<HTMLButtonElement>("[data-deck-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-deck-next]");
    const i = order.indexOf(name);
    if (prev) prev.toggleAttribute("disabled", i === 0);
    if (next) next.toggleAttribute("disabled", i === order.length - 1);

    setTimeout(() => { switching = false; }, 650);
  }

  function step(delta: number) {
    const i = order.indexOf(current) + delta;
    if (i >= 0 && i < order.length) activate(order[i]);
  }

  // Tab clicks
  tabs.forEach((t) => t.addEventListener("click", () => activate(t.dataset.tab!)));

  // Goto buttons (e.g. "Enter the evening")
  document.querySelectorAll<HTMLElement>("[data-goto]").forEach((el) =>
    el.addEventListener("click", () => activate(el.dataset.goto!)),
  );

  // Arrows
  document.querySelector("[data-deck-prev]")?.addEventListener("click", () => step(-1));
  document.querySelector("[data-deck-next]")?.addEventListener("click", () => step(1));

  // Click anywhere on the active panel -> advance to next (except on interactive elements)
  const noAdvance = 'a, button, input, textarea, select, label, [role="tab"], [data-goto], [data-noadvance], .sigt__bar, .sigt-arrow';
  panels.forEach((p) => {
    p.addEventListener("click", (e) => {
      if (p.dataset.panel !== current) return;
      const t = e.target as HTMLElement;
      if (t.closest(noAdvance)) return;         // let links/buttons/forms work
      if (window.getSelection()?.toString()) return; // don't hijack text selection
      if (order.indexOf(current) < order.length - 1) step(1);
    });
  });

  // Keyboard
  window.addEventListener("keydown", (e) => {
    if (gate && document.body.contains(gate)) return; // locked
    if (e.key === "ArrowRight" || e.key === "PageDown") { e.preventDefault(); step(1); }
    if (e.key === "ArrowLeft" || e.key === "PageUp") { e.preventDefault(); step(-1); }
  });

  // Horizontal swipe (mobile)
  let touchX = 0, touchY = 0;
  window.addEventListener("touchstart", (e) => {
    touchX = e.touches[0].clientX;
    touchY = e.touches[0].clientY;
  }, { passive: true });
  window.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].clientX - touchX;
    const dy = e.changedTouches[0].clientY - touchY;
    if (Math.abs(dx) > 70 && Math.abs(dx) > Math.abs(dy) * 1.5) {
      step(dx < 0 ? 1 : -1);
    }
  }, { passive: true });

  // ===== Gate wiring =====
  if (gate && main && form && input) {
    try {
      if (sessionStorage.getItem("sigUnlocked") === "1") unlock(false);
      else setTimeout(() => input.focus(), 300);
    } catch {}

    const expected = (gate.dataset.code || "").trim().toLowerCase();
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const v = input.value.trim().toLowerCase();
      if (v === expected) unlock();
      else if (err) { err.textContent = "Code not recognised."; input.select(); }
    });
  }

  // ===== Newsletter -> prefilled email =====
  const news = document.getElementById("sigNews") as HTMLFormElement | null;
  const newsOk = document.getElementById("sigNewsOk") as HTMLElement | null;
  if (news) {
    news.addEventListener("submit", (e) => {
      e.preventDefault();
      const email = (news.querySelector('input[name="email"]') as HTMLInputElement).value.trim();
      if (!email) return;
      const subject = encodeURIComponent("Signature Newsletter");
      const body = encodeURIComponent(`Hello,\n\nPlease add me to the Signature newsletter.\n\nEmail: ${email}\n\nThank you.`);
      window.location.href = `mailto:eugeniecolleville.paris@gmail.com?subject=${subject}&body=${body}`;
      if (newsOk) newsOk.hidden = false;
    });
  }
</script>
